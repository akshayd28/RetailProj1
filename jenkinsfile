pipeline {
    agent any
    
    environment {
        LABS = credentials('labcreds')
    }
    
    stages {
        
        stage('Build') {
            steps {
                sh 'pip3 install --user pipenv'
                sh '/bitnami/jenkins/home/.local/bin/pipenv --rm || exit 0'
                sh '/bitnami/jenkins/home/.local/bin/pipenv install'
            }
        }
        stage('Test') {
            steps {
                
                sh '/bitnami/jenkins/home/.local/bin/pipenv run pytest'
                
            }
        }
        stage('Package') {
            steps {
                // Create the zip file but exclude the venv directory
                sh 'zip -r RetailProj1.zip .'
            }
        }
        stage('Deploy') {
            steps {
                // Add deployment steps here (e.g., deploy to a server or cloud)
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no -r .
                $LABS_USR@g02.itversity.com:/home/itv016155/RetailProj1'
            }
        }
    }
}
